# Copy to .env.local for local development. Never commit real values.
DIRECT_URL="******localhost:5432/clutchverse?schema=public"
DATABASE_URL="postgresql://clutchverse:clutchverse@localhost:5432/clutchverse?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXTAUTH_SECRET=""
AUTH_URL="http://localhost:3000"
WEB_ORIGIN="http://localhost:3000"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"
REALTIME_PORT="4001"
RESEND_API_KEY=""
EMAIL_FROM="ClutchVerse <hello@example.com>"
CONTACT_TO_EMAIL="hello@clutchverse.gg"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_MODE="disabled"
TWITCH_CLIENT_ID=""
YOUTUBE_API_KEY=""
# Optional, server-only spotlight providers. Provider event mappings are
# unverified and remain disabled; never put these credentials in NEXT_PUBLIC_*.
LIQUIPEDIA_API_KEY=""
LIQUIPEDIA_USER_AGENT="ClutchVerse/1.0 (contact: admin@example.com)"
LIQUIPEDIA_MAX_REQUESTS_PER_HOUR="60"
PANDASCORE_TOKEN=""
PANDASCORE_MAX_REQUESTS_PER_HOUR="60"
# Server-only Gemini credential for the chatbot, Block D translation/moderation,
# and match-vision suggestions; never expose it with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Private, durable directory for match evidence; local development defaults to the OS temp directory.
MATCH_EVIDENCE_DIRECTORY=""
MATCH_VISION_GEMINI_MODEL="gemini-flash-latest"
# Private, durable directory for creator clip uploads; development uses OS temp storage.
CREATOR_MEDIA_DIRECTORY=""
TWITCH_CLIENT_SECRET=""
DISCORD_SERVER_ID=""
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
JAZZCASH_MERCHANT_ID=""
