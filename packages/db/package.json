{
  "name": "@clutchverse/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "lint": "DATABASE_URL=postgresql://clutchverse:clutchverse@localhost:5432/clutchverse prisma validate",
    "typecheck": "DATABASE_URL=postgresql://clutchverse:clutchverse@localhost:5432/clutchverse prisma validate",
    "build": "DATABASE_URL=postgresql://clutchverse:clutchverse@localhost:5432/clutchverse prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
